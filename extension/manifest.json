{
  "manifest_version": 3,
  "name": "Trace Cleaner — sidebar",
  "version": "1.1.0",
  "description": "Sidebar quét & làm sạch dấu vết AI trong văn bản, có humanize tuỳ chọn.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://openrouter.ai/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Trace Cleaner — mở sidebar" },
  "side_panel": { "default_path": "panel.html" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+T" }
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["sidebar.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
