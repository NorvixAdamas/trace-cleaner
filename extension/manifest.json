{
  "manifest_version": 3,
  "name": "Trace Cleaner — sidebar",
  "version": "1.2.0",
  "description": "Sidebar quét & làm sạch dấu vết AI trong văn bản, có humanize tuỳ chọn.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "activeTab", "scripting", "sidePanel"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://openrouter.ai/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Trace Cleaner — mở sidebar",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "side_panel": { "default_path": "panel.html" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+T" }
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["sidebar.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
